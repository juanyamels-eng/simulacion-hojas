extends Node
## Bus de eventos global. Los sistemas se comunican por señales para evitar dependencias circulares.

signal money_changed(amount: float)
signal money_earned(amount: float, world_pos: Vector3)
signal leaves_collected(count: int, source: String)
signal bag_changed(count: int, capacity: int)
signal bag_delivered(leaves: int, money: float, distance: float)
signal bag_closed(leaves: int)
signal upgrade_purchased(id: String, level: int)
signal tool_changed(tool_id: String)
signal tool_unlocked(tool_id: String)
signal zone_progress(zone_id: String, pct: float)
signal zone_reward(zone_id: String, threshold: int, text: String)
signal zone_unlocked(zone_id: String)
signal zone_entered(zone_id: String)
signal zone_completed(zone_id: String)
signal gate_opened(gate_id: String)
signal duct_repaired(duct_id: String)
signal pile_created(size: int)
signal toast(title: String, body: String, kind: String)
signal achievement_unlocked(id: String)
signal objective_completed(id: String)
signal collectible_found(id: String)
signal note_read(title: String, text: String)
signal hint(text: String)
signal settings_changed()
signal stat_changed(key: String, value: float)
signal game_saved()
signal open_menu(menu: String)
